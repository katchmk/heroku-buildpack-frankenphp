#!/usr/bin/env bash
# bin/compile <build-dir> <cache-dir> <env-dir>
#
# Compiles a PHP application for deployment with FrankenPHP.

set -eo pipefail

BUILD_DIR="${1}"
CACHE_DIR="${2}"
ENV_DIR="${3}"

# Load utilities
BIN_DIR=$(cd "$(dirname "$0")"; pwd)
source "${BIN_DIR}/../lib/utils.sh"

# Configuration
FRANKENPHP_VERSION="${FRANKENPHP_VERSION:-latest}"
FRANKENPHP_BINARY_TYPE="${FRANKENPHP_BINARY_TYPE:-musl}"  # musl (static) or gnu (dynamic extensions)
FRANKENPHP_BINARY_URL=""
FRANKENPHP_CUSTOM_BINARY_URL="${FRANKENPHP_CUSTOM_BINARY_URL:-}"

# Build output functions
indent() {
    sed -u 's/^/       /'
}

puts_step() {
    echo "-----> $*"
}

puts_warn() {
    echo " !     $*" >&2
}

# Export environment variables from env dir
export_env_dir() {
    local env_dir=$1
    local allowlist_regex=${2:-''}
    local denylist_regex=${3:-'^(PATH|GIT_DIR|CPATH|CPPATH|LD_PRELOAD|LIBRARY_PATH)$'}

    if [[ -d "$env_dir" ]]; then
        for e in $(ls "$env_dir"); do
            echo "$e" | grep -E "$denylist_regex" && continue
            if [[ -z "$allowlist_regex" ]] || echo "$e" | grep -qE "$allowlist_regex"; then
                export "$e=$(cat "$env_dir/$e")"
            fi
        done
    fi
}

# Get FrankenPHP download URL
get_frankenphp_url() {
    local version=$1
    local binary_type=$2

    # Use custom URL if provided
    if [[ -n "$FRANKENPHP_CUSTOM_BINARY_URL" ]]; then
        FRANKENPHP_BINARY_URL="$FRANKENPHP_CUSTOM_BINARY_URL"
        puts_step "Using custom FrankenPHP binary URL"
        return
    fi

    # Determine binary suffix based on type
    local binary_suffix="frankenphp-linux-x86_64"
    if [[ "$binary_type" == "gnu" ]]; then
        binary_suffix="frankenphp-linux-x86_64-gnu"
        puts_step "Using glibc-based binary (supports dynamic extensions)"
    else
        puts_step "Using musl-based binary (static, no dynamic extensions)"
    fi

    if [[ "$version" == "latest" ]]; then
        # Get latest release URL from GitHub API
        local release_info
        release_info=$(curl -sL "https://api.github.com/repos/php/frankenphp/releases/latest")
        FRANKENPHP_BINARY_URL=$(echo "$release_info" | grep -o "\"browser_download_url\": *\"[^\"]*${binary_suffix}\"" | head -1 | sed 's/.*: *"\([^"]*\)"/\1/')
    else
        FRANKENPHP_BINARY_URL="https://github.com/php/frankenphp/releases/download/${version}/${binary_suffix}"
    fi

    if [[ -z "$FRANKENPHP_BINARY_URL" ]]; then
        puts_warn "Failed to determine FrankenPHP download URL"
        exit 1
    fi
}

# Download FrankenPHP binary
download_frankenphp() {
    local cache_file="${CACHE_DIR}/frankenphp-${FRANKENPHP_VERSION}-${FRANKENPHP_BINARY_TYPE}"

    # If using custom URL, use a hash of the URL for cache key
    if [[ -n "$FRANKENPHP_CUSTOM_BINARY_URL" ]]; then
        local url_hash=$(echo "$FRANKENPHP_CUSTOM_BINARY_URL" | md5sum | cut -d' ' -f1)
        cache_file="${CACHE_DIR}/frankenphp-custom-${url_hash}"
    fi

    if [[ -f "$cache_file" ]]; then
        puts_step "Using cached FrankenPHP binary"
        cp "$cache_file" "${BUILD_DIR}/.heroku/frankenphp/bin/frankenphp"
    else
        puts_step "Downloading FrankenPHP ${FRANKENPHP_VERSION}..."
        get_frankenphp_url "$FRANKENPHP_VERSION" "$FRANKENPHP_BINARY_TYPE"

        mkdir -p "${BUILD_DIR}/.heroku/frankenphp/bin"

        if ! curl -sL "$FRANKENPHP_BINARY_URL" -o "${BUILD_DIR}/.heroku/frankenphp/bin/frankenphp"; then
            puts_warn "Failed to download FrankenPHP"
            exit 1
        fi

        # Cache for future builds
        mkdir -p "$CACHE_DIR"
        cp "${BUILD_DIR}/.heroku/frankenphp/bin/frankenphp" "$cache_file"
    fi

    chmod +x "${BUILD_DIR}/.heroku/frankenphp/bin/frankenphp"
}

# Install Composer dependencies
install_composer_deps() {
    if [[ ! -f "${BUILD_DIR}/composer.json" ]]; then
        puts_step "No composer.json found, skipping Composer install"
        return
    fi

    puts_step "Installing Composer dependencies..."

    cd "$BUILD_DIR"

    # Use FrankenPHP's built-in PHP for Composer
    export PATH="${BUILD_DIR}/.heroku/frankenphp/bin:$PATH"

    # Download Composer if not present
    if [[ ! -f "${BUILD_DIR}/.heroku/frankenphp/bin/composer" ]]; then
        puts_step "Downloading Composer..."
        curl -sS https://getcomposer.org/installer | frankenphp php-cli -- --install-dir="${BUILD_DIR}/.heroku/frankenphp/bin" --filename=composer
    fi

    # Install dependencies
    if [[ -f "${BUILD_DIR}/composer.lock" ]]; then
        frankenphp php-cli "${BUILD_DIR}/.heroku/frankenphp/bin/composer" install --no-dev --optimize-autoloader --no-interaction 2>&1 | indent
    else
        frankenphp php-cli "${BUILD_DIR}/.heroku/frankenphp/bin/composer" install --no-dev --optimize-autoloader --no-interaction 2>&1 | indent
    fi
}

# Setup default Caddyfile if not present
setup_caddyfile() {
    if [[ -f "${BUILD_DIR}/Caddyfile" ]]; then
        puts_step "Using existing Caddyfile"
        return
    fi

    puts_step "Creating default Caddyfile..."

    # Determine document root
    local doc_root=""
    if [[ -d "${BUILD_DIR}/public" ]]; then
        doc_root="/app/public"
    elif [[ -d "${BUILD_DIR}/web" ]]; then
        doc_root="/app/web"
    else
        doc_root="/app"
    fi

    cat > "${BUILD_DIR}/Caddyfile" << EOF
{
    # Heroku provides SSL termination at the router level
    auto_https off

    # Use PORT environment variable
    http_port {\$PORT}

    frankenphp {
        # Enable worker mode for better performance (optional)
        # worker /app/public/index.php
    }
}

:\$PORT {
    root * ${doc_root}

    # Encode responses
    encode zstd gzip

    # Try PHP files first, then static files, then index.php
    php_server
}
EOF
}

# Setup Procfile if not present
setup_procfile() {
    if [[ -f "${BUILD_DIR}/Procfile" ]]; then
        puts_step "Using existing Procfile"
        return
    fi

    puts_step "Creating default Procfile..."
    cat > "${BUILD_DIR}/Procfile" << 'EOF'
web: .heroku/frankenphp/bin/frankenphp run --config Caddyfile
EOF
}

# Setup PHP extensions directory and load extensions if using glibc binary
setup_extensions() {
    mkdir -p "${BUILD_DIR}/.heroku/frankenphp/ext"
    mkdir -p "${BUILD_DIR}/.heroku/frankenphp/conf.d"

    # Check for user-provided extensions in the app
    if [[ -d "${BUILD_DIR}/.php-extensions" ]]; then
        puts_step "Installing custom PHP extensions..."
        cp "${BUILD_DIR}/.php-extensions"/*.so "${BUILD_DIR}/.heroku/frankenphp/ext/" 2>/dev/null || true

        # Create ini files for each extension
        for ext in "${BUILD_DIR}/.heroku/frankenphp/ext"/*.so; do
            if [[ -f "$ext" ]]; then
                local ext_name=$(basename "$ext" .so)
                echo "extension=${ext_name}.so" > "${BUILD_DIR}/.heroku/frankenphp/conf.d/${ext_name}.ini"
                puts_step "  - Loaded extension: ${ext_name}"
            fi
        done
    fi

    # Check for extension ini files
    if [[ -d "${BUILD_DIR}/.php-extensions/conf.d" ]]; then
        cp "${BUILD_DIR}/.php-extensions/conf.d"/*.ini "${BUILD_DIR}/.heroku/frankenphp/conf.d/" 2>/dev/null || true
    fi
}

# Setup profile.d script for runtime
setup_profile() {
    mkdir -p "${BUILD_DIR}/.profile.d"

    cat > "${BUILD_DIR}/.profile.d/frankenphp.sh" << 'EOF'
export PATH="$HOME/.heroku/frankenphp/bin:$PATH"

# PHP extension directory for glibc-based builds
export PHP_INI_SCAN_DIR="$HOME/.heroku/frankenphp/conf.d"

# Extension directory
if [[ -d "$HOME/.heroku/frankenphp/ext" ]]; then
    export PHP_EXTENSION_DIR="$HOME/.heroku/frankenphp/ext"
fi
EOF
}

# Main build process
main() {
    puts_step "FrankenPHP Buildpack"

    # Export environment variables
    export_env_dir "$ENV_DIR"

    # Check for custom FrankenPHP version
    if [[ -f "${ENV_DIR}/FRANKENPHP_VERSION" ]]; then
        FRANKENPHP_VERSION=$(cat "${ENV_DIR}/FRANKENPHP_VERSION")
        puts_step "Using FrankenPHP version: ${FRANKENPHP_VERSION}"
    fi

    # Check for binary type (musl or gnu)
    if [[ -f "${ENV_DIR}/FRANKENPHP_BINARY_TYPE" ]]; then
        FRANKENPHP_BINARY_TYPE=$(cat "${ENV_DIR}/FRANKENPHP_BINARY_TYPE")
    fi

    # Check for custom binary URL (for custom builds with specific extensions)
    if [[ -f "${ENV_DIR}/FRANKENPHP_CUSTOM_BINARY_URL" ]]; then
        FRANKENPHP_CUSTOM_BINARY_URL=$(cat "${ENV_DIR}/FRANKENPHP_CUSTOM_BINARY_URL")
        puts_step "Using custom FrankenPHP binary"
    fi

    # Create build directories
    mkdir -p "${BUILD_DIR}/.heroku/frankenphp/bin"
    mkdir -p "$CACHE_DIR"

    # Download and setup FrankenPHP
    download_frankenphp

    # Display PHP version info
    puts_step "FrankenPHP/PHP version:"
    "${BUILD_DIR}/.heroku/frankenphp/bin/frankenphp" version 2>&1 | indent || true

    # Install Composer dependencies
    install_composer_deps

    # Setup extensions (for glibc-based builds)
    if [[ "$FRANKENPHP_BINARY_TYPE" == "gnu" ]] || [[ -n "$FRANKENPHP_CUSTOM_BINARY_URL" ]]; then
        setup_extensions
    fi

    # Setup configuration files
    setup_caddyfile
    setup_procfile
    setup_profile

    puts_step "Build complete!"
}

main "$@"
