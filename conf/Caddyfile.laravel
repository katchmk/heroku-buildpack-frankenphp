# Caddyfile optimized for Laravel applications on Heroku
#
# Copy this file to your project root as 'Caddyfile' and customize as needed.
#
# This file does not use worker mode: Laravel's public/index.php cannot run as
# a FrankenPHP worker. For worker mode, use Laravel Octane instead of this file
# (see "Framework-Specific Setup" in the README).
{
	auto_https off
	http_port {$PORT}

	frankenphp

	log {
		output stdout
		format console
	}
}

:{$PORT} {
	root * /app/public

	# Do not serve hidden files (.env, .git, ...)
	@hidden {
		path_regexp "(^|/)\."
		not path /.well-known/*
	}
	respond @hidden 404

	encode zstd gzip

	# Serve static files, and send all other requests to Laravel's front controller
	php_server {
		try_files {path} index.php
	}

	# Security headers
	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Serve static assets with caching
	@static {
		path *.css *.js *.ico *.gif *.jpg *.jpeg *.png *.svg *.woff *.woff2
	}
	header @static Cache-Control "public, max-age=31536000"
}
