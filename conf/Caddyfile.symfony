# Caddyfile optimized for Symfony applications on Heroku
#
# Copy this file to your project root as 'Caddyfile' and customize as needed.

{
    auto_https off
    http_port {$PORT}

    frankenphp {
        # Enable worker mode for Symfony Runtime compatibility
        worker /app/public/index.php {
            num {$FRANKENPHP_WORKERS:2}
        }
    }

    log {
        output stdout
        format console
    }
}

:{$PORT} {
    root * /app/public

    encode zstd gzip

    # Symfony front controller pattern
    php_server

    # Security headers
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # Cache static assets
    @static {
        path /bundles/* *.css *.js *.ico *.gif *.jpg *.jpeg *.png *.svg *.woff *.woff2
    }
    header @static Cache-Control "public, max-age=31536000"
}
