# Caddyfile optimized for Symfony applications on Heroku
#
# Copy this file to your project root as 'Caddyfile' and customize as needed.
#
# Worker mode works without more configuration on Symfony 7.4 and later.
# On older versions, install runtime/frankenphp-symfony and set this config var:
#   heroku config:set APP_RUNTIME='Runtime\FrankenPhpSymfony\Runtime'
{
	auto_https off
	http_port {$PORT}

	frankenphp {
		# Keep the Symfony kernel in memory between requests
		worker {
			file /app/public/index.php
			num {$FRANKENPHP_WORKERS:2}
		}
	}

	log {
		output stdout
		format console
	}
}

:{$PORT} {
	root * /app/public

	# Do not serve hidden files (.env, .git, ...)
	@hidden {
		path_regexp "(^|/)\."
		not path /.well-known/*
	}
	respond @hidden 404

	encode zstd gzip

	# Symfony front controller pattern
	php_server

	# Security headers
	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Cache static assets
	@static {
		path /bundles/* *.css *.js *.ico *.gif *.jpg *.jpeg *.png *.svg *.woff *.woff2
	}
	header @static Cache-Control "public, max-age=31536000"
}
